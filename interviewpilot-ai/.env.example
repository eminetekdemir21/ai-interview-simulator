# Google AI Studio'dan ucretsiz alinan Gemini API key'ini buraya yapistir
# https://aistudio.google.com/apikey
GEMINI_API_KEY=senin_api_keyin

# Istersen farkli bir Gemini modeli kullanabilirsin (varsayilan: gemini-2.5-flash)
GEMINI_MODEL=gemini-3.5-flash-lite

# Sadece canli (HTTPS) yayinlarken "true" yap; yerel gelistirmede (http://127.0.0.1)
# bos/false birak, yoksa giris cerezi tarayicida calismaz
COOKIE_SECURE=false

# Sifremi Unuttum ve E-posta Dogrulama icin gercek e-posta gonderimi.
# Gmail kullanmak istersen: Google Hesabinda 2 Adimli Dogrulama'yi ac, sonra
# https://myaccount.google.com/apppasswords adresinden bir "Uygulama Sifresi"
# olustur (normal Gmail sifren DEGIL, bu ayri 16 haneli kod). Bos birakilirsa
# bu iki ozellik calismaz ama uygulamanin geri kalani normal calismaya devam eder.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=senin_gmail_adresin@gmail.com
SMTP_PASSWORD=16_haneli_uygulama_sifresi
SMTP_FROM=senin_gmail_adresin@gmail.com
