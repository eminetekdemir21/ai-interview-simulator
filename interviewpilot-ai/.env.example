# Google AI Studio'dan ucretsiz alinan Gemini API key'ini buraya yapistir
# https://aistudio.google.com/apikey
GEMINI_API_KEY=senin_api_keyin

# Istersen farkli bir Gemini modeli kullanabilirsin (varsayilan: gemini-2.5-flash)
GEMINI_MODEL=gemini-3.5-flash-lite

# Sadece canli (HTTPS) yayinlarken "true" yap; yerel gelistirmede (http://127.0.0.1)
# bos/false birak, yoksa giris cerezi tarayicida calismaz
COOKIE_SECURE=false

# Sifremi Unuttum ve E-posta Dogrulama icin gercek e-posta gonderimi.
# Bos birakilirsa bu iki ozellik calismaz ama uygulamanin geri kalani normal
# calismaya devam eder.
#
# SECENEK 1 (onerilen, kolay kurulum): resend.com'da ucretsiz hesap ac,
# API key olustur. Domain dogrulamadan test icin "onboarding@resend.dev"
# adresinden gonderim yapabilirsin (sadece kendi hesap e-postana gider).
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
#
# SECENEK 2: Gmail App Password (2 Adimli Dogrulama gerektirir,
# https://myaccount.google.com/apppasswords). RESEND_API_KEY doluysa bu
# secenek kullanilmaz.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=senin_gmail_adresin@gmail.com
SMTP_PASSWORD=16_haneli_uygulama_sifresi
SMTP_FROM=senin_gmail_adresin@gmail.com
